<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.GameController">
   <children>
      <Label fx:id="statusLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true" />
      <GridPane alignment="CENTER" hgap="5.0" vgap="5.0">
         <children>
            <Button fx:id="b00" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button fx:id="b01" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button fx:id="b02" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Button fx:id="b10" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button fx:id="b11" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="b12" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button fx:id="b20" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button fx:id="b21" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="b22" mnemonicParsing="false" onAction="#cellClicked" prefHeight="90.0" prefWidth="90.0" style="-fx-font-size: 36px;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
         </children>
      </GridPane>
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>
